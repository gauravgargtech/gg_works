{
  "name": "oanda-dashboard",
  "version": "1.0.0",
  "description": "Fetches OANDA trade history on a cron schedule, stores it in MongoDB, and serves a metrics dashboard with Express + EJS + Chart.js.",
  "main": "src/app.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/app.js",
    "dev": "node --watch src/app.js",
    "fetch": "node src/jobs/fetchOanda.js",
    "cron": "node src/jobs/scheduler.js"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "mongoose": "^8.7.0",
    "node-cron": "^3.0.3"
  }
}
