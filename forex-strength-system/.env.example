# ===== OANDA =====
# Practice (demo) account works fine for price data — no live funding needed.
OANDA_API_KEY=your_oanda_api_token
OANDA_ACCOUNT_ID=your_oanda_account_id
# practice = demo (api-fxpractice.oanda.com) | live = api-fxtrade.oanda.com
OANDA_ENVIRONMENT=practice

# ===== FRED =====
# Free key — register at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key

# ===== GROQ =====
GROQ_API_KEY=your_groq_api_key
# Cheaper/faster model below. For better sentiment quality, swap to a bigger
# Groq-hosted model (e.g. llama-3.3-70b-versatile) at the cost of latency/quota.
GROQ_MODEL=llama-3.1-8b-instant

# ===== MONGODB =====
MONGODB_URI=mongodb://localhost:27017/forex_strength

# ===== SCHEDULING (cron expressions) =====
# Technical (price-based) score — cheap, can run often
TECHNICAL_CRON=*/15 * * * *
# Full pipeline incl. FRED rates + news + LLM sentiment — keep this sparser
# to respect FRED/Groq rate limits and because rates/news don't move every 15 min
FULL_PIPELINE_CRON=0 */4 * * *

# Run the full pipeline once immediately on boot (true/false)
RUN_ON_BOOT=true
