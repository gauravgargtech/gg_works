<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sentiment Tracker</title>
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --bg: #080d1a;
        --surface: #0f1623;
        --card: #141c2e;
        --border: #1e2d45;
        --border2: #243452;
        --text: #cbd5e1;
        --muted: #475569;
        --dim: #1e2d45;

        --bull: #22d3a5;
        --bull-bg: rgba(34, 211, 165, 0.1);
        --bull-glow: rgba(34, 211, 165, 0.2);
        --bear: #f87171;
        --bear-bg: rgba(248, 113, 113, 0.1);
        --bear-glow: rgba(248, 113, 113, 0.2);
        --neut: #fbbf24;
        --neut-bg: rgba(251, 191, 36, 0.1);
        --neut-glow: rgba(251, 191, 36, 0.2);

        --mono: "IBM Plex Mono", monospace;
        --sans: "Inter", sans-serif;
      }

      html,
      body {
        height: 100%;
      }
      body {
        font-family: var(--sans);
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        padding: 0 0 60px;
      }

      /* ── HEADER ── */
      header {
        background: var(--surface);
        border-bottom: 1px solid var(--border);
        padding: 20px 32px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .header-left {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .logo-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--bull);
        box-shadow: 0 0 8px var(--bull);
        animation: pulse 2s ease-in-out infinite;
      }
      @keyframes pulse {
        0%,
        100% {
          opacity: 1;
          box-shadow: 0 0 8px var(--bull);
        }
        50% {
          opacity: 0.6;
          box-shadow: 0 0 18px var(--bull);
        }
      }
      header h1 {
        font-family: var(--mono);
        font-size: 14px;
        font-weight: 600;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #e2e8f0;
      }
      .header-meta {
        font-family: var(--mono);
        font-size: 11px;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 20px;
      }
      .header-meta span {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .update-dot {
        width: 6px;
        height: 6px;
        border-radius: 50%;
        background: var(--neut);
      }

      /* ── SUMMARY BAR ── */
      .summary-bar {
        padding: 20px 32px;
        display: flex;
        gap: 16px;
        overflow-x: auto;
      }
      .stat-chip {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 8px;
        padding: 14px 20px;
        min-width: 150px;
        flex-shrink: 0;
      }
      .stat-chip .label {
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--muted);
        margin-bottom: 6px;
      }
      .stat-chip .value {
        font-family: var(--mono);
        font-size: 24px;
        font-weight: 600;
      }
      .stat-chip.bull .value {
        color: var(--bull);
      }
      .stat-chip.bear .value {
        color: var(--bear);
      }
      .stat-chip.neut .value {
        color: var(--neut);
      }
      .stat-chip.total .value {
        color: #e2e8f0;
      }

      /* ── TABLE WRAPPER ── */
      .table-wrap {
        padding: 0 32px;
        overflow-x: auto;
      }

      /* ── TABLE ── */
      table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0 6px;
      }
      thead th {
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 500;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--muted);
        text-align: left;
        padding: 0 16px 10px;
        border-bottom: 1px solid var(--border);
      }
      thead th:last-child {
        text-align: left;
      }
      thead th.center {
        text-align: center;
      }

      tbody tr {
        background: var(--card);
        border-radius: 10px;
        transition: background 0.15s;
      }
      tbody tr:hover {
        background: #192236;
      }

      tbody td {
        padding: 16px 16px;
        vertical-align: middle;
      }
      tbody td:first-child {
        border-radius: 10px 0 0 10px;
      }
      tbody td:last-child {
        border-radius: 0 10px 10px 0;
      }

      /* ── SYMBOL CELL ── */
      .symbol-cell {
        display: flex;
        align-items: center;
        gap: 10px;
      }
      .sym-icon {
        width: 34px;
        height: 34px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 11px;
        font-weight: 600;
        flex-shrink: 0;
      }
      .sym-name {
        font-family: var(--mono);
        font-size: 14px;
        font-weight: 600;
        color: #e2e8f0;
        letter-spacing: 0.04em;
      }
      .sym-sub {
        font-size: 11px;
        color: var(--muted);
        margin-top: 2px;
      }

      /* ── BEAD TRACK ── */
      .bead-track {
        display: flex;
        align-items: center;
        gap: 0;
        min-width: 260px;
      }
      .bead-wrap {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 5px;
      }
      .bead {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: var(--mono);
        font-size: 10px;
        font-weight: 600;
        border: 2px solid transparent;
        transition: transform 0.15s;
        cursor: default;
        position: relative;
      }
      .bead:hover {
        transform: scale(1.12);
      }
      .bead.bull {
        background: var(--bull-bg);
        border-color: var(--bull);
        color: var(--bull);
      }
      .bead.bear {
        background: var(--bear-bg);
        border-color: var(--bear);
        color: var(--bear);
      }
      .bead.neut {
        background: var(--neut-bg);
        border-color: var(--neut);
        color: var(--neut);
      }
      .bead.latest {
        width: 42px;
        height: 42px;
        font-size: 11px;
        box-shadow: 0 0 14px var(--glow, transparent);
      }
      .bead.bull.latest {
        --glow: var(--bull-glow);
      }
      .bead.bear.latest {
        --glow: var(--bear-glow);
      }
      .bead.neut.latest {
        --glow: var(--neut-glow);
      }

      .bead-label {
        font-family: var(--mono);
        font-size: 9px;
        color: var(--muted);
        letter-spacing: 0.04em;
        white-space: nowrap;
      }
      .bead-wrap.latest .bead-label {
        color: var(--text);
      }

      .connector {
        height: 2px;
        width: 28px;
        flex-shrink: 0;
        margin-bottom: 18px; /* offset for label */
      }
      .connector.bull-bull {
        background: linear-gradient(90deg, var(--bull), var(--bull));
        opacity: 0.35;
      }
      .connector.bull-bear {
        background: linear-gradient(90deg, var(--bull), var(--bear));
        opacity: 0.35;
      }
      .connector.bull-neut {
        background: linear-gradient(90deg, var(--bull), var(--neut));
        opacity: 0.35;
      }
      .connector.bear-bull {
        background: linear-gradient(90deg, var(--bear), var(--bull));
        opacity: 0.35;
      }
      .connector.bear-bear {
        background: linear-gradient(90deg, var(--bear), var(--bear));
        opacity: 0.35;
      }
      .connector.bear-neut {
        background: linear-gradient(90deg, var(--bear), var(--neut));
        opacity: 0.35;
      }
      .connector.neut-bull {
        background: linear-gradient(90deg, var(--neut), var(--bull));
        opacity: 0.35;
      }
      .connector.neut-bear {
        background: linear-gradient(90deg, var(--neut), var(--bear));
        opacity: 0.35;
      }
      .connector.neut-neut {
        background: linear-gradient(90deg, var(--neut), var(--neut));
        opacity: 0.35;
      }

      /* ── TREND CELL ── */
      .trend-cell {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .trend-arrow {
        font-size: 18px;
        font-weight: 700;
        line-height: 1;
      }
      .trend-arrow.up {
        color: var(--bull);
      }
      .trend-arrow.down {
        color: var(--bear);
      }
      .trend-arrow.flat {
        color: var(--neut);
      }
      .trend-delta {
        font-family: var(--mono);
        font-size: 12px;
      }
      .trend-delta.up {
        color: var(--bull);
      }
      .trend-delta.down {
        color: var(--bear);
      }
      .trend-delta.flat {
        color: var(--neut);
      }

      /* ── CURRENT SCORE BADGE ── */
      .score-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-radius: 20px;
        font-family: var(--mono);
        font-size: 13px;
        font-weight: 600;
        white-space: nowrap;
      }
      .score-badge.bull {
        background: var(--bull-bg);
        color: var(--bull);
        border: 1px solid rgba(34, 211, 165, 0.25);
      }
      .score-badge.bear {
        background: var(--bear-bg);
        color: var(--bear);
        border: 1px solid rgba(248, 113, 113, 0.25);
      }
      .score-badge.neut {
        background: var(--neut-bg);
        color: var(--neut);
        border: 1px solid rgba(251, 191, 36, 0.25);
      }

      /* ── SUMMARY CELL ── */
      .summary-cell {
        max-width: 300px;
      }
      .summary-text {
        font-size: 12px;
        color: var(--text);
        line-height: 1.55;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .summary-more {
        display: inline-block;
        margin-top: 4px;
        font-size: 11px;
        font-family: var(--mono);
        color: var(--muted);
        cursor: pointer;
        text-decoration: underline;
      }
      .summary-more:hover {
        color: var(--text);
      }

      /* ── EXPAND PANEL ── */
      .expanded-row td {
        padding: 0 16px 12px;
        background: #192236 !important;
        border-radius: 0 0 10px 10px !important;
      }
      .expanded-row td:first-child {
        border-radius: 0 0 0 10px !important;
      }
      .expanded-row td:last-child {
        border-radius: 0 0 10px 0 !important;
      }
      .expanded-content {
        font-size: 12.5px;
        line-height: 1.65;
        color: var(--text);
        padding: 12px 0 4px;
        border-top: 1px solid var(--border);
      }

      /* ── EMPTY STATE ── */
      .empty {
        text-align: center;
        padding: 60px 32px;
        color: var(--muted);
        font-family: var(--mono);
        font-size: 13px;
      }

      /* ── FOOTER ── */
      footer {
        text-align: center;
        padding: 32px;
        font-family: var(--mono);
        font-size: 11px;
        color: var(--muted);
        border-top: 1px solid var(--border);
        margin-top: 32px;
      }

      /* ── TOOLTIP ── */
      .bead[data-tip] {
        position: relative;
      }
      .bead[data-tip]:hover::after {
        content: attr(data-tip);
        position: absolute;
        bottom: calc(100% + 8px);
        left: 50%;
        transform: translateX(-50%);
        background: #1e2d45;
        border: 1px solid var(--border2);
        color: var(--text);
        font-family: var(--mono);
        font-size: 10px;
        white-space: nowrap;
        padding: 5px 9px;
        border-radius: 5px;
        pointer-events: none;
        z-index: 99;
      }

      /* ── SECTION LABEL ── */
      .section-label {
        padding: 24px 32px 12px;
        font-family: var(--mono);
        font-size: 10px;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--muted);
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .section-label::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border);
      }

      @media (max-width: 900px) {
        header {
          padding: 16px 20px;
        }
        .summary-bar {
          padding: 16px 20px;
        }
        .table-wrap {
          padding: 0 12px;
        }
        .section-label {
          padding: 20px 20px 10px;
        }
        .bead-track {
          min-width: 220px;
        }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="header-left">
        <div class="logo-dot"></div>
        <h1>Sentiment Tracker</h1>
      </div>
      <div class="header-meta">
        <span
          ><div class="update-dot"></div>
          Updates every 1h on score change</span
        >
        <span id="last-updated">—</span>
      </div>
    </header>

    <!-- Summary bar injected by JS -->
    <div class="summary-bar" id="summary-bar"></div>

    <div class="section-label">Symbol Feed — Last 4 Score Changes</div>

    <div class="table-wrap">
      <table id="sentiment-table">
        <thead>
          <tr>
            <th>Symbol</th>
            <th>
              Score History
              <span style="font-weight: 400; opacity: 0.5"
                >← older · newer →</span
              >
            </th>
            <th class="center">Trend</th>
            <th>Current</th>
            <th>Summary</th>
          </tr>
        </thead>
        <tbody id="table-body"></tbody>
      </table>
      <div class="empty" id="empty-state" style="display: none">
        No sentiment data loaded. Replace <code>SENTIMENT_DATA</code> with your
        MongoDB results.
      </div>
    </div>

    <footer>
      Sentiment data refreshed on score change only &nbsp;·&nbsp; Scores range
      −1.0 (extreme bear) → +1.0 (extreme bull)
    </footer>

    <script>
      // ─────────────────────────────────────────────
      // REPLACE THIS ARRAY WITH YOUR MONGODB RESULTS
      // Each entry: { symbol, category, scores: [ { score, mode, summary, ts } ] }
      // scores[0] = oldest, scores[last] = newest
      // ─────────────────────────────────────────────

        const SENTIMENT_DATA = <%- JSON.stringify(data) %>;


      function scoreClass(score) {
        if (score >= 6) return "bull";
        if (score <= 6) return "bear";
        return "neut";
      }

      function modeLabel(mode) {
        const m = (mode || "").toLowerCase();
        if (m.includes("bull")) return "bull";
        if (m.includes("bear")) return "bear";
        return "neut";
      }

      function scoreEmoji(cls) {
        return cls === "bull" ? "▲" : cls === "bear" ? "▼" : "●";
      }

      const COLORS = { bull: "#22D3A5", bear: "#F87171", neut: "#FBBF24" };

      const SYMBOL_INITIALS = (sym) => sym.slice(0, 3);
      const SYMBOL_COLORS = {
        bull: { bg: "rgba(34,211,165,.12)", color: "#22D3A5" },
        bear: { bg: "rgba(248,113,113,.12)", color: "#F87171" },
        neut: { bg: "rgba(251,191,36,.12)", color: "#FBBF24" },
      };

      function buildBeadTrack(scores) {
        const div = document.createElement("div");
        div.className = "bead-track";
        scores.forEach((s, i) => {
          const cls = modeLabel(s.mode);
          const isLatest = i === scores.length - 1;

          const wrap = document.createElement("div");
          wrap.className = "bead-wrap" + (isLatest ? " latest" : "");

          const bead = document.createElement("div");
          bead.className = `bead ${cls}${isLatest ? " latest" : ""}`;
          bead.textContent = (s.score >= 0 ? "+" : "") + s.score.toFixed(2);
          bead.setAttribute("data-tip", s.ts || `T-${scores.length - 1 - i}`);

          const label = document.createElement("div");
          label.className = "bead-label";
          label.textContent = isLatest ? "NOW" : `T-${scores.length - 1 - i}`;

          wrap.appendChild(bead);
          wrap.appendChild(label);
          div.appendChild(wrap);

          if (i < scores.length - 1) {
            const nextCls = modeLabel(scores[i + 1].mode);
            const line = document.createElement("div");
            line.className = `connector ${cls}-${nextCls}`;
            div.appendChild(line);
          }
        });
        return div;
      }

      function buildTrend(scores) {
        const first = scores[0].score;
        const last = scores[scores.length - 1].score;
        const delta = last - first;
        const dir = delta > 0.05 ? "up" : delta < -0.05 ? "down" : "flat";
        const arrow = dir === "up" ? "↑" : dir === "down" ? "↓" : "→";
        const sign = delta >= 0 ? "+" : "";

        const td = document.createElement("td");
        td.innerHTML = `
      <div class="trend-cell">
        <span class="trend-arrow ${dir}">${arrow}</span>
        <span class="trend-delta ${dir}">${sign}${delta.toFixed(2)}</span>
      </div>`;
        return td;
      }

      function renderTable(data) {
        const tbody = document.getElementById("table-body");
        const emptyEl = document.getElementById("empty-state");
        tbody.innerHTML = "";

        if (!data || data.length === 0) {
          emptyEl.style.display = "block";
          return;
        }

        data.forEach((item, rowIdx) => {
          const scores = item.scores.slice(-4); // ensure max 4
          const latest = scores[scores.length - 1];
          const latestCls = modeLabel(latest.mode);
          const sc = SYMBOL_COLORS[latestCls];

          const tr = document.createElement("tr");

          // Symbol cell
          const tdSym = document.createElement("td");
          tdSym.innerHTML = `
        <div class="symbol-cell">
          <div class="sym-icon" style="background:${sc.bg};color:${sc.color}">${SYMBOL_INITIALS(item.symbol)}</div>
          <div>
            <div class="sym-name">${item.symbol}</div>
            <div class="sym-sub">${item.category || ""}</div>
          </div>
        </div>`;
          tr.appendChild(tdSym);

          // Bead track cell
          const tdBeads = document.createElement("td");
          tdBeads.appendChild(buildBeadTrack(scores));
          tr.appendChild(tdBeads);

          // Trend cell
          tr.appendChild(buildTrend(scores));

          // Current score badge
          const tdScore = document.createElement("td");
          tdScore.innerHTML = `
        <div class="score-badge ${latestCls}">
          ${scoreEmoji(latestCls)} ${latest.score >= 0 ? "+" : ""}${latest.score.toFixed(2)}
          <span style="font-size:10px;opacity:.7">${latest.mode}</span>
        </div>`;
          tr.appendChild(tdScore);

          // Summary cell
          const tdSum = document.createElement("td");
          tdSum.className = "summary-cell";
          const summaryId = `summary-${rowIdx}`;
          tdSum.innerHTML = `
        <div class="summary-text" id="${summaryId}">${latest.summary || "—"}</div>
        <span class="summary-more" onclick="toggleRow(${rowIdx})">▾ expand</span>`;
          tr.appendChild(tdSum);

          tbody.appendChild(tr);

          // Expanded row (hidden by default)
          const expandTr = document.createElement("tr");
          expandTr.className = "expanded-row";
          expandTr.id = `expand-row-${rowIdx}`;
          expandTr.style.display = "none";

          const expandTd = document.createElement("td");
          expandTd.colSpan = 5;
          // Build history entries
          const histHtml = scores
            .map((s, i) => {
              const cls = modeLabel(s.mode);
              const isL = i === scores.length - 1;
              return `<div style="display:flex;gap:10px;align-items:flex-start;margin-bottom:10px;">
          <div style="font-family:var(--mono);font-size:10px;color:var(--muted);width:50px;padding-top:2px;flex-shrink:0">${s.ts || (isL ? "NOW" : `T-${scores.length - 1 - i}`)}</div>
          <div style="font-family:var(--mono);font-size:11px;color:${COLORS[cls]};width:60px;flex-shrink:0">${s.score >= 0 ? "+" : ""}${s.score.toFixed(2)} ${s.mode}</div>
          <div style="font-size:12px;color:var(--text);line-height:1.55">${s.summary}</div>
        </div>`;
            })
            .reverse()
            .join("");

          expandTd.innerHTML = `<div class="expanded-content">${histHtml}</div>`;
          expandTr.appendChild(expandTd);
          tbody.appendChild(expandTr);
        });
      }

      function toggleRow(idx) {
        const row = document.getElementById(`expand-row-${idx}`);
        const btn = row.previousElementSibling.querySelector(".summary-more");
        if (!row) return;
        const visible = row.style.display !== "none";
        row.style.display = visible ? "none" : "table-row";
        btn.textContent = visible ? "▾ expand" : "▴ collapse";
      }

      function renderSummary(data) {
        let bull = 0,
          bear = 0,
          neut = 0;
        data.forEach((d) => {
          const cls = modeLabel(d.scores[d.scores.length - 1].mode);
          if (cls === "bull") bull++;
          else if (cls === "bear") bear++;
          else neut++;
        });
      }

      function updateTimestamp() {
        const el = document.getElementById("last-updated");
        const now = new Date();
        el.textContent =
          "Page loaded " +
          now.toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });
      }

      // Init
      renderTable(SENTIMENT_DATA);
      renderSummary(SENTIMENT_DATA);
      updateTimestamp();
    </script>
  </body>
</html>
