<%
  // Accepts: array of orders/positions, or { orders: [], positions: [] }
  const all = Array.isArray(data) ? data : [].concat((data && data.orders) || [], (data && data.positions) || []);
  const orders = all.filter((x) => x && x.orderId);
  const positions = all.filter((x) => x && !x.orderId && Number(x.size) > 0);
  const has = (v) => v !== undefined && v !== null && v !== '' && Number(v) !== 0;
  const show = (v) => (has(v) ? v : '—');
  const t = (ms) => (ms ? new Date(Number(ms)).toISOString().replace('T', ' ').slice(0, 19) + ' UTC' : '—');
%><!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Bybit Futures Manager</title>
<style>
  :root { --bg:#0e1116; --panel:#161b22; --panel-2:#1c232d; --border:#2a323d; --text:#e6edf3; --muted:#8b97a6;
          --green:#2ebd85; --red:#f6465d; --accent:#f7a600; --blue:#3b82f6; }
  @media (prefers-color-scheme: light) {
    :root { --bg:#f4f6f8; --panel:#fff; --panel-2:#f0f2f5; --border:#d8dee6; --text:#14181f; --muted:#5d6877; }
  }
  * { box-sizing: border-box; }
  html, body { margin:0; background:var(--bg); color:var(--text); font:14px/1.45 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif; }
  body { padding:16px; max-width:1400px; margin:0 auto; }
  header { display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:space-between; margin-bottom:14px; }
  h1 { font-size:18px; margin:0; }
  h2 { font-size:15px; margin:20px 0 8px; }
  .count { background:var(--panel-2); border-radius:999px; padding:0 8px; margin-left:6px; font-size:11px; }
  button { font:inherit; cursor:pointer; border-radius:7px; border:1px solid var(--border); background:var(--panel-2); color:var(--text); padding:7px 12px; }
  button:hover { border-color:var(--muted); }
  button:disabled { opacity:.5; cursor:not-allowed; }
  button.primary { background:var(--accent); color:#000; border-color:var(--accent); font-weight:600; }
  button.danger { background:transparent; color:var(--red); border-color:var(--red); }
  button.danger:hover { background:var(--red); color:#fff; }
  button.small { padding:4px 9px; font-size:12px; }
  .panel { background:var(--panel); border:1px solid var(--border); border-radius:10px; overflow:hidden; }
  .overflow { overflow-x:auto; }
  table { width:100%; border-collapse:collapse; }
  th, td { padding:10px 12px; text-align:left; white-space:nowrap; }
  th { color:var(--muted); font-weight:500; font-size:12px; border-bottom:1px solid var(--border); background:var(--panel-2); }
  tbody tr + tr td { border-top:1px solid var(--border); }
  td.actions { display:flex; gap:6px; }
  .num { font-variant-numeric:tabular-nums; }
  .buy, .pos { color:var(--green); } .sell, .neg { color:var(--red); }
  .muted { color:var(--muted); } .sym { font-weight:600; }
  .empty { padding:36px 16px; text-align:center; color:var(--muted); }

  @media (max-width:820px) {
    body { padding:10px; }
    table, thead, tbody, tr, td { display:block; }
    thead { display:none; }
    tbody tr { padding:10px 12px; }
    tbody tr + tr { border-top:1px solid var(--border); }
    tbody tr + tr td { border-top:0; }
    td { display:flex; justify-content:space-between; gap:12px; padding:4px 0; white-space:normal; text-align:right; }
    td::before { content:attr(data-label); color:var(--muted); text-align:left; }
    td.actions { justify-content:flex-end; padding-top:10px; }
    td.actions button { flex:1; padding:9px; }
  }

  dialog { border:1px solid var(--border); border-radius:12px; background:var(--panel); color:var(--text); padding:0; width:min(440px, calc(100vw - 24px)); }
  dialog::backdrop { background:rgba(0,0,0,.6); }
  .modal-h { padding:14px 16px; border-bottom:1px solid var(--border); font-weight:600; }
  .modal-b { padding:16px; display:grid; gap:12px; }
  .modal-f { padding:12px 16px; border-top:1px solid var(--border); display:flex; justify-content:flex-end; gap:8px; }
  label { display:grid; gap:4px; font-size:12px; color:var(--muted); }
  input, select { font:inherit; padding:9px 10px; border-radius:7px; border:1px solid var(--border); background:var(--bg); color:var(--text); width:100%; }
  input:focus, select:focus { outline:2px solid var(--blue); outline-offset:-1px; }
  .row2 { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
  .hint { font-size:12px; color:var(--muted); }
  .info { background:var(--panel-2); border-radius:8px; padding:10px; font-size:13px; }
  #toasts { position:fixed; bottom:14px; left:50%; transform:translateX(-50%); display:grid; gap:8px; z-index:50; width:min(460px, calc(100vw - 24px)); }
  .toast { padding:10px 14px; border-radius:8px; background:var(--panel); border:1px solid var(--border); box-shadow:0 6px 20px rgba(0,0,0,.35); }
  .toast.ok { border-color:var(--green); } .toast.err { border-color:var(--red); }
</style>
</head>
<body>

<header>
  <h1>Bybit Futures Manager</h1>
  <button class="small" onclick="location.reload()">Refresh</button>
</header>

<h2>Open Orders <span class="count"><%= orders.length %></span></h2>
<section class="panel"><div class="overflow">
<% if (!orders.length) { %>
  <div class="empty">No open futures orders.</div>
<% } else { %>
  <table>
    <thead><tr>
      <th>Symbol</th><th>Side</th><th>Type</th><th>Price</th><th>Qty</th><th>Trigger</th>
      <th>TP</th><th>SL</th><th>Flags</th><th>Status</th><th>Created</th><th></th>
    </tr></thead>
    <tbody>
    <% orders.forEach((o) => {
         const flags = [o.reduceOnly ? 'Reduce' : '', o.closeOnTrigger ? 'Close' : '', (o.stopOrderType && o.stopOrderType !== 'UNKNOWN') ? o.stopOrderType : ''].filter(Boolean).join(', ');
    %>
      <tr data-order='<%= JSON.stringify({ orderId: o.orderId, symbol: o.symbol, side: o.side, orderType: o.orderType, qty: o.qty, price: o.price, takeProfit: o.takeProfit, stopLoss: o.stopLoss, tpTriggerBy: o.tpTriggerBy, slTriggerBy: o.slTriggerBy }) %>'>
        <td data-label="Symbol" class="sym"><%= o.symbol %></td>
        <td data-label="Side" class="<%= o.side === 'Buy' ? 'buy' : 'sell' %>"><%= o.side %></td>
        <td data-label="Type"><%= o.orderType %></td>
        <td data-label="Price" class="num"><%= o.orderType === 'Market' ? 'Market' : show(o.price) %></td>
        <td data-label="Qty" class="num"><%= o.qty %><% if (has(o.cumExecQty)) { %> <span class="muted">(<%= o.cumExecQty %> filled)</span><% } %></td>
        <td data-label="Trigger" class="num"><%= show(o.triggerPrice) %></td>
        <td data-label="TP" class="num pos"><%= show(o.takeProfit) %></td>
        <td data-label="SL" class="num neg"><%= show(o.stopLoss) %></td>
        <td data-label="Flags"><%= flags || '—' %></td>
        <td data-label="Status"><%= o.orderStatus %></td>
        <td data-label="Created" class="muted"><%= t(o.createdTime) %></td>
        <td data-label="" class="actions">
          <button class="small" data-act="order-tpsl">TP/SL</button>
          <button class="small danger" data-act="order-cancel">Cancel</button>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
<% } %>
</div></section>

<h2>Positions <span class="count"><%= positions.length %></span></h2>
<section class="panel"><div class="overflow">
<% if (!positions.length) { %>
  <div class="empty">No open positions.</div>
<% } else { %>
  <table>
    <thead><tr>
      <th>Symbol</th><th>Side</th><th>Size</th><th>Entry</th><th>Mark</th><th>Liq.</th>
      <th>Unrealised PnL</th><th>TP</th><th>SL</th><th>Lev.</th><th></th>
    </tr></thead>
    <tbody>
    <% positions.forEach((p) => { %>
      <tr data-pos='<%= JSON.stringify({ symbol: p.symbol, side: p.side, size: p.size, positionIdx: p.positionIdx, avgPrice: p.avgPrice, markPrice: p.markPrice, takeProfit: p.takeProfit, stopLoss: p.stopLoss, tpTriggerBy: p.tpTriggerBy, slTriggerBy: p.slTriggerBy }) %>'>
        <td data-label="Symbol" class="sym"><%= p.symbol %></td>
        <td data-label="Side" class="<%= p.side === 'Buy' ? 'buy' : 'sell' %>"><%= p.side === 'Buy' ? 'Long' : 'Short' %></td>
        <td data-label="Size" class="num"><%= p.size %></td>
        <td data-label="Entry" class="num"><%= show(p.avgPrice) %></td>
        <td data-label="Mark" class="num"><%= show(p.markPrice) %></td>
        <td data-label="Liq." class="num"><%= show(p.liqPrice) %></td>
        <td data-label="Unrealised PnL" class="num <%= Number(p.unrealisedPnl) >= 0 ? 'pos' : 'neg' %>"><%= p.unrealisedPnl %></td>
        <td data-label="TP" class="num pos"><%= show(p.takeProfit) %></td>
        <td data-label="SL" class="num neg"><%= show(p.stopLoss) %></td>
        <td data-label="Lev." class="num"><%= p.leverage %>x</td>
        <td data-label="" class="actions">
          <button class="small" data-act="pos-tpsl">TP/SL</button>
          <button class="small danger" data-act="pos-close">Close</button>
        </td>
      </tr>
    <% }) %>
    </tbody>
  </table>
<% } %>
</div></section>

<dialog id="tpsl">
  <form method="dialog" id="tpsl-form">
    <div class="modal-h" id="tpsl-title">Set TP / SL</div>
    <div class="modal-b">
      <div class="info" id="tpsl-info"></div>
      <label>Take Profit price <input id="tp" inputmode="decimal" placeholder="Leave blank to keep current"></label>
      <label>Stop Loss price <input id="sl" inputmode="decimal" placeholder="Leave blank to keep current"></label>
      <div class="row2">
        <label>TP trigger <select id="tpby"><option>LastPrice</option><option>MarkPrice</option><option>IndexPrice</option></select></label>
        <label>SL trigger <select id="slby"><option>LastPrice</option><option>MarkPrice</option><option>IndexPrice</option></select></label>
      </div>
      <div class="hint">Enter <b>0</b> to remove an existing TP or SL.</div>
    </div>
    <div class="modal-f">
      <button type="button" id="tpsl-cancel">Cancel</button>
      <button type="submit" class="primary" id="tpsl-save">Save</button>
    </div>
  </form>
</dialog>

<div id="toasts" aria-live="polite"></div>

<script>
(() => {
  const $ = (s) => document.querySelector(s);
  const esc = (v) => String(v ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
  const has = (v) => v !== undefined && v !== null && v !== '' && Number(v) !== 0;
  let modal = null;

  function toast(msg, type = 'ok') {
    const el = document.createElement('div');
    el.className = 'toast ' + type;
    el.textContent = msg;
    $('#toasts').appendChild(el);
    setTimeout(() => el.remove(), type === 'err' ? 6000 : 3000);
  }

  const getToken = () => { try { return sessionStorage.getItem('apiToken') || ''; } catch { return ''; } };
  const setToken = (t) => { try { sessionStorage.setItem('apiToken', t); } catch {} };

  async function api(path, body, retried = false) {
    const res = await fetch(path, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-api-token': getToken() },
      body: JSON.stringify(body),
    });
    if (res.status === 401 && !retried) {
      const t = prompt('Enter API token');
      if (t === null) throw new Error('Unauthorized');
      setToken(t);
      return api(path, body, true);
    }
    let json;
    try { json = await res.json(); } catch { throw new Error('Bad response from server'); }
    if (!res.ok || !json.ok) throw new Error(json.error || 'Request failed');
    return json;
  }

  async function run(fn, okMsg) {
    try { await fn(); toast(okMsg); setTimeout(() => location.reload(), 700); }
    catch (e) { toast(e.message, 'err'); }
  }

  function openTpsl(kind, item) {
    modal = { kind, item };
    const sideCls = item.side === 'Buy' ? 'buy' : 'sell';
    $('#tpsl-title').textContent = kind === 'order' ? 'Set TP / SL on order' : 'Set TP / SL on position';
    $('#tpsl-info').innerHTML = kind === 'order'
      ? `<b>${esc(item.symbol)}</b> · <span class="${sideCls}">${esc(item.side)}</span> ${esc(item.orderType)} · Qty ${esc(item.qty)} @ ${item.orderType === 'Market' ? 'Market' : esc(item.price)}`
      : `<b>${esc(item.symbol)}</b> · <span class="${sideCls}">${item.side === 'Buy' ? 'Long' : 'Short'}</span> · Size ${esc(item.size)} · Entry ${esc(item.avgPrice)} · Mark ${esc(item.markPrice)}`;
    $('#tp').value = has(item.takeProfit) ? item.takeProfit : '';
    $('#sl').value = has(item.stopLoss) ? item.stopLoss : '';
    $('#tpby').value = item.tpTriggerBy || 'LastPrice';
    $('#slby').value = item.slTriggerBy || 'LastPrice';
    $('#tpsl').showModal();
    $('#tp').focus();
  }

  $('#tpsl-cancel').addEventListener('click', () => $('#tpsl').close());

  $('#tpsl-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const { kind, item } = modal;
    const tp = $('#tp').value.trim(), sl = $('#sl').value.trim();
    const origTp = has(item.takeProfit) ? String(item.takeProfit) : '';
    const origSl = has(item.stopLoss) ? String(item.stopLoss) : '';
    const body = {
      symbol: item.symbol,
      takeProfit: tp !== origTp ? tp : '',
      stopLoss: sl !== origSl ? sl : '',
      tpTriggerBy: $('#tpby').value,
      slTriggerBy: $('#slby').value,
    };
    if (!body.takeProfit && !body.stopLoss) { toast('Nothing changed', 'err'); return; }

    const btn = $('#tpsl-save');
    btn.disabled = true;
    try {
      if (kind === 'order') { body.orderId = item.orderId; await api('/api/orders/tpsl', body); }
      else { body.positionIdx = item.positionIdx; await api('/api/positions/tpsl', body); }
      $('#tpsl').close();
      toast('TP/SL updated');
      setTimeout(() => location.reload(), 700);
    } catch (err) { toast(err.message, 'err'); }
    finally { btn.disabled = false; }
  });

  document.addEventListener('click', (e) => {
    const btn = e.target.closest('button[data-act]');
    if (!btn) return;
    const row = btn.closest('tr');
    const a = btn.dataset.act;

    if (a.startsWith('order')) {
      const o = JSON.parse(row.dataset.order);
      if (a === 'order-tpsl') return openTpsl('order', o);
      if (confirm(`Cancel ${o.side} ${o.orderType} order for ${o.symbol} (qty ${o.qty})?`))
        run(() => api('/api/orders/cancel', { symbol: o.symbol, orderId: o.orderId }), 'Order cancelled');
    } else {
      const p = JSON.parse(row.dataset.pos);
      if (a === 'pos-tpsl') return openTpsl('position', p);
      if (confirm(`Close ${p.side === 'Buy' ? 'LONG' : 'SHORT'} ${p.symbol} (size ${p.size}) at MARKET?`))
        run(() => api('/api/positions/close', { symbol: p.symbol, side: p.side, size: p.size, positionIdx: p.positionIdx }), 'Close order sent');
    }
  });
})();
</script>
</body>
</html>